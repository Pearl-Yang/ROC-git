# =============================================================================
# ROC-git 云端部署环境变量模板
# 用法：
#   1) cp .env.cloud.example .env.cloud
#   2) 替换下面所有 <...> 占位符为真实值
#   3) docker compose -f docker-compose.cloud.yml --env-file .env.cloud up -d
# =============================================================================

# ---- 镜像仓库 ---------------------------------------------------------------
# 阿里云 ACR：registry.cn-hangzhou.aliyuncs.com/<命名空间>/<仓库>
# 腾讯云 TCR：ccr.ccs.tencentyun.com/<命名空间>/<仓库>
REGISTRY=registry.cn-hangzhou.aliyuncs.com
IMAGE_NAMESPACE=rocgit
IMAGE_TAG=1.0.0

# ---- 云端 MySQL（推荐用云 RDS，不建议再用容器 MySQL） -------------------------
# 阿里云 RDS / 腾讯云 CynosDB 的内网地址 + 端口
DB_HOST=<RDS 内网地址>.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=roc_git
DB_USER=rocgit
DB_PASSWORD=<RDS 强密码>

# ---- 域名 --------------------------------------------------------------------
DOMAIN=rocgit.example.com
# 是否启用 HTTPS（true / false）
HTTPS_ENABLED=true

# ---- JWT --------------------------------------------------------------------
# 生产环境请用 openssl rand -base64 64 生成
JWT_SECRET=<64 位随机字符串>

# ---- 文件存储 ----------------------------------------------------------------
# 容器内统一路径，云端挂到 EFS / 持久化 SSD / OSS（OSS 走 S3FileStorageService）
UPLOAD_DIR=/data/rocgit/files
# H5 访问文件的 base-url（前端用 nginx alias 出静态文件）
# 生产建议改为 https 域名
ROCGIT_FILE_BASE_URL=https://${DOMAIN}/files

# ---- W2：对象存储 OSS / COS / S3 切换 ----------------------------------------
# local（默认）= 本地盘；s3 = 启用 S3FileStorageService（走 S3 兼容协议）
ROCGIT_FILE_PROVIDER=local
# 阿里云 OSS 示例：https://oss-cn-shanghai.aliyuncs.com
# 腾讯云 COS 示例：https://cos.ap-shanghai.myqcloud.com
# AWS S3 示例：  https://s3.us-east-1.amazonaws.com
ROCGIT_FILE_S3_ENDPOINT=
ROCGIT_FILE_S3_BUCKET=
ROCGIT_FILE_S3_ACCESS_KEY=
ROCGIT_FILE_S3_SECRET_KEY=
ROCGIT_FILE_S3_REGION=oss-cn-shanghai
ROCGIT_FILE_S3_PATH_PREFIX=rocgit/

# ---- 短信（生产启用腾讯云） ---------------------------------------------------
SMS_PROVIDER=tencent
TENCENT_SMS_SECRET_ID=<腾讯云 API 密钥 SecretId>
TENCENT_SMS_SECRET_KEY=<腾讯云 API 密钥 SecretKey>
TENCENT_SMS_APP_ID=<应用 ID>
TENCENT_SMS_SIGN_NAME=ROC-git
TENCENT_SMS_TEMPLATE_ID=<模板 ID>

# ---- 时区 --------------------------------------------------------------------
TZ=Asia/Shanghai
